APP_ENV=local
DATABASE_URL=postgresql://northwind:northwind@localhost:5432/northwind
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_stub
STRIPE_WEBHOOK_SECRET=whsec_stub
VITE_API_URL=http://localhost:8000

# Optional SaaS integrations. Blank values disable each integration locally.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_APP_ENV=local
VITE_RELEASE=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# Supabase Postgres uses DATABASE_URL above; use its pooler connection string.

# Optional monitoring. Empty OTLP endpoint means no outbound telemetry.
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=0.1
REQUEST_LOG_SAMPLE_RATIO=0.1
OTEL_METRIC_EXPORT_INTERVAL=60
