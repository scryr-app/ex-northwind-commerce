"""Scryr manifest for the Northwind Commerce sample."""

from scryr import (
    AuthType,
    CICDToolType,
    CredentialRef,
    Metrics,
    PrometheusSource,
    Classification,
    DeploymentTarget,
    Diagram,
    Forge,
    ForgeTask,
    ForgeTool,
    IaCToolType,
    Link,
    LogAggregationType,
    Manifest,
    PostHogSource,
    MonitoringType,
    ProgrammingLanguage,
    TracingType,
    Url,
    WebFramework,
    parse_version,
)

_REPO_URL = Url("https://github.com/scryr-app/ex-northwind-commerce")
_LOCAL_DEPLOYMENT = DeploymentTarget.unknown
_IAC = IaCToolType.terraform
_MONITORING = MonitoringType.none
_LOGS = LogAggregationType.none
_TRACING = TracingType.none
_CICD = CICDToolType.github_actions

northwind_forge = Forge(
    name="Northwind Commerce Service",
    description="Local development toolchain and common tasks for the Northwind Commerce sample.",
    tools={
        "python": ForgeTool(version="3.12"),
        "node": ForgeTool(version="22"),
        "postgres": "16",
        "redis": "7",
    },
    env={
        "DATABASE_URL": "postgresql://northwind:northwind@localhost:5432/northwind",
        "REDIS_URL": "redis://localhost:6379/0",
        "VITE_API_URL": "http://localhost:8000",
        "STRIPE_SECRET_KEY": "sk_test_stub",
    },
    tasks={
        "dev": ForgeTask(
            description="Run the full local stack",
            run="docker compose up --build",
        ),
        "test:api": ForgeTask(
            description="Run the FastAPI test suite",
            run="uv run pytest",
            dir="api",
        ),
        "test:web": ForgeTask(
            description="Run the frontend test suite",
            run="npm test",
            dir="web",
        ),
        "smoke": ForgeTask(
            description="Run the end-to-end smoke test",
            run="./scripts/smoke-test.sh",
        ),
    },
)

# Project ID, host and read token resolve through the private server connection.
# The SQL and presentation remain versioned here. Only tagged production events count.
_POSTHOG_EVENTS = {
    "catalogViews": ("catalog_viewed", "Catalog views"),
    "cartUpdates": ("cart_updated", "Cart updates"),
    "checkoutStarts": ("checkout_started", "Checkout starts"),
    "paymentIntents": ("checkout_intent_created", "Stripe payment intents"),
    "stubbedIntents": ("checkout_intent_created", "Stubbed checkout intents"),
    "checkoutFailures": ("checkout_failed", "Checkout failures"),
}
_POSTHOG_QUERIES = {
    key: (
        "SELECT count() FROM events WHERE event = '" + event + "' "
        "AND timestamp >= toDateTime({start}) AND timestamp < toDateTime({end}) "
        "AND properties.environment = {environment}"
        + (" AND properties.payment_mode = 'stripe'" if key == "paymentIntents" else "")
        + (" AND properties.payment_mode = 'stubbed'" if key == "stubbedIntents" else "")
    )
    for key, (event, _label) in _POSTHOG_EVENTS.items()
}
_NORTHWIND_ANALYTICS = PostHogSource(
    credentials=CredentialRef(name="northwind-posthog-read"),
    project_id=598963,
    query_endpoint="https://us.posthog.com",
    dashboard_url="https://us.posthog.com/project/598963/dashboard/2074658",
    environment="production",
    refresh="on_diagram_load",
    window=86400,
    cache_ttl=60,
    ingestion_delay=120,
    queries=_POSTHOG_QUERIES,
    labels={key: label for key, (_event, label) in _POSTHOG_EVENTS.items()},
    units={key: "events" for key in _POSTHOG_EVENTS},
)

northwind_web = Manifest(
    analytics=_NORTHWIND_ANALYTICS,
    manifest_id="northwind-commerce/web",
    name="northwind-web",
    classification=Classification.public_ui,
    tags=["frontend", "react", "vite", "b2b-storefront"],
    forges=[northwind_forge.name],
    connections=["northwind-api"],
    description="React/Vite B2B storefront for browsing Northwind products, building carts, and checking out through the API.",
    language=ProgrammingLanguage.typescript,
    deployment=_LOCAL_DEPLOYMENT,
    owner_team="Commerce",
    auth_type=AuthType.none,
    monitoring=_MONITORING,
    log_aggregation=_LOGS,
    tracing=_TRACING,
    iac_tool=_IAC,
    docs=["web/src/App.tsx", "web/src/api.ts", "README.md"],
    links=[Link(site_name="Source", http_url=_REPO_URL)],
    repo_url=_REPO_URL,
    cicd_tool=_CICD,
)

# Query configuration is public; credentials are resolved only by the Scryr server.
# The approved query endpoint is resolved from northwind-grafana-read until its
# Grafana Cloud endpoint is available to declare here as query_endpoint.
_GRAFANA_DASHBOARD = (
    "https://nimbleomelette894.grafana.net"
    "/d/northwind-observability/northwind-commerce"
)
_REQUEST_RATE = 'sum(rate(northwind_http_requests_total{job="northwind-api"}[5m]))'
_LATENCY_BUCKETS = (
    'sum by (le) (rate(northwind_http_request_duration_seconds_bucket'
    '{job="northwind-api"}[5m]))'
)
_NORTHWIND_METRICS = PrometheusSource(
    credentials=CredentialRef(name="northwind-grafana-read"),
    dashboard_url=_GRAFANA_DASHBOARD,
    environment="production",
    refresh="on_diagram_load",
    window=900,  # Previous 15 minutes, in seconds.
    step=60,
    cache_ttl=60,
    ingestion_delay=120,
    queries={
        "requestRate": _REQUEST_RATE,
        "responseTimeP50": f"1000 * histogram_quantile(0.50, {_LATENCY_BUCKETS})",
        "responseTimeP95": f"1000 * histogram_quantile(0.95, {_LATENCY_BUCKETS})",
        "responseTimeP99": f"1000 * histogram_quantile(0.99, {_LATENCY_BUCKETS})",
        # Missing 5xx series means zero only when request telemetry exists.
        # With zero traffic the ratio is NaN, which Scryr displays as unavailable.
        "errorRate": (
            '(100 * (sum(rate(northwind_http_requests_total'
            '{job="northwind-api",status_code=~"5.."}[5m]))'
            f" or (0 * {_REQUEST_RATE}))) / ({_REQUEST_RATE})"
        ),
    },
    units={
        "requestRate": "req/s",
        "responseTimeP50": "ms",
        "responseTimeP95": "ms",
        "responseTimeP99": "ms",
        "errorRate": "%",
    },
)

northwind_api = Manifest(
    metrics=Metrics(provider=_NORTHWIND_METRICS),
    manifest_id="northwind-commerce/api",
    name="northwind-api",
    classification=Classification.internal_api,
    tags=["api", "fastapi", "catalog", "checkout", "risk"],
    forges=[northwind_forge.name],
    connections=["northwind-postgres", "northwind-redis", "stripe-integration"],
    description="FastAPI service that exposes product catalog, order, risk-control, and checkout workflows for the storefront.",
    language=ProgrammingLanguage.python,
    frameworks=[WebFramework.fastapi],
    deployment=_LOCAL_DEPLOYMENT,
    owner_team="Commerce",
    auth_type=AuthType.api_key,
    monitoring=_MONITORING,
    log_aggregation=_LOGS,
    tracing=_TRACING,
    iac_tool=_IAC,
    max_replicas=2,
    min_replicas=1,
    docs=["api/src/northwind_api/main.py", "docs/architecture.md", "docs/runbook.md"],
    links=[Link(site_name="Source", http_url=_REPO_URL)],
    repo_url=_REPO_URL,
    cicd_tool=_CICD,
)

northwind_postgres = Manifest(
    name="northwind-postgres",
    classification=Classification.database,
    tags=["database", "postgres", "migrations", "orders"],
    forges=[northwind_forge.name],
    connections=["northwind-api"],
    description="PostgreSQL database for catalog, customer, and order state, managed through SQL migrations under api/migrations.",
    version=parse_version("16.0.0"),
    language=ProgrammingLanguage.sql,
    deployment=_LOCAL_DEPLOYMENT,
    owner_team="Commerce",
    auth_type=AuthType.basic,
    monitoring=_MONITORING,
    log_aggregation=_LOGS,
    tracing=_TRACING,
    iac_tool=_IAC,
    max_replicas=1,
    min_replicas=1,
    docs=["api/migrations/001_initial.sql"],
    repo_url=_REPO_URL,
    cicd_tool=_CICD,
)

northwind_redis = Manifest(
    name="northwind-redis",
    classification=Classification.cache_store,
    tags=["cache", "redis", "session-state"],
    forges=[northwind_forge.name],
    connections=["northwind-api"],
    description="Redis cache used by the API for low-latency workflow and checkout support.",
    version=parse_version("7.0.0"),
    language=ProgrammingLanguage.c,
    deployment=_LOCAL_DEPLOYMENT,
    owner_team="Commerce",
    auth_type=AuthType.basic,
    monitoring=_MONITORING,
    log_aggregation=_LOGS,
    tracing=_TRACING,
    iac_tool=_IAC,
    max_replicas=1,
    min_replicas=1,
    repo_url=_REPO_URL,
    cicd_tool=_CICD,
)

stripe_integration = Manifest(
    name="stripe-integration",
    classification=Classification.public_api,
    tags=["payment", "stripe", "checkout", "risk-controls"],
    forges=[northwind_forge.name],
    connections=["northwind-api"],
    description="Stripe test-mode payment integration guarded by order velocity, high-value purchase, and expedited shipping risk controls.",
    deployment=DeploymentTarget.unknown,
    owner_team="Commerce",
    auth_type=AuthType.api_key,
    monitoring=_MONITORING,
    log_aggregation=_LOGS,
    tracing=_TRACING,
    iac_tool=_IAC,
    max_replicas=1,
    min_replicas=1,
    docs=["api/src/northwind_api/stripe_client.py", "api/src/northwind_api/risk.py"],
    links=[Link(site_name="Stripe Docs", http_url=Url("https://stripe.com/docs"))],
    repo_url=_REPO_URL,
    cicd_tool=CICDToolType.none,
)

northwind_commerce_diagram = Diagram(
    name="Northwind Commerce Diagram",
    manifests=[northwind_web, northwind_api, northwind_redis, stripe_integration],
)
